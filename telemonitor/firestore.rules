rules_version = '2';

// TeleMonitor Firestore security rules.
//
// A patient may register without a clinician and link to one later, but
// only once: `assignedClinicianId` can be written when absent, never changed.
//
// Readings and events follow thesis ch.4 §Data structure:
//  * readings are append-only and validated on write (plausible range,
//    pressure pair, measurement time); a correction is a new reading that
//    names the one it supersedes;
//  * events (alerts) are created by the patient's phone (rule or model
//    escalation) or by the clinician's application (non-transmission), and
//    closed once by the assigned clinician with a verdict; never deleted.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myProfileExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isClinician() {
      return myProfileExists() && myProfile().role == 'clinician';
    }

    function isMyPatientDoc() {
      return isClinician()
        && resource.data.assignedClinicianId == request.auth.uid;
    }

    function isMyClinicianDoc(userId) {
      return myProfileExists()
        && myProfile().keys().hasAny(['assignedClinicianId'])
        && myProfile().assignedClinicianId == userId;
    }

    function isAssignedClinicianOf(patientId) {
      return isClinician()
        && exists(/databases/$(database)/documents/users/$(patientId))
        && get(/databases/$(database)/documents/users/$(patientId))
             .data.assignedClinicianId == request.auth.uid;
    }

    function targetIsClinician(clinicianId) {
      return exists(/databases/$(database)/documents/users/$(clinicianId))
        && get(/databases/$(database)/documents/users/$(clinicianId)).data.role == 'clinician';
    }

    // The fields a patient may never alter about themselves.
    function touchesProtected() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'assignedClinicianId', 'email', 'checkupPeriodDays']);
    }

    // The assigned clinician sets the checkup period (1 to 30 days) and
    // nothing else on the patient's profile.
    function isCheckupPeriodUpdate() {
      return isMyPatientDoc()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkupPeriodDays'])
        && request.resource.data.checkupPeriodDays is int
        && request.resource.data.checkupPeriodDays >= 1
        && request.resource.data.checkupPeriodDays <= 30;
    }

    function optInt(d, k, lo, hi) {
      return d.get(k, null) == null || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }

    // A new reading: known fields only; values in the plausible ranges of
    // the entry screen (thesis Table "tab:units"); a pressure pair complete
    // and coherent; glucose in mmol/L; measured at most 30 days before it
    // reaches the server and not in the future; record time set by the
    // server; a superseded reading must exist.
    function isValidReading(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['timestamp', 'recordedAt', 'entryMode', 'sbp', 'dbp', 'glucose', 'hr',
                               'context', 'notes', 'readingCount', 'firstSbp', 'firstDbp', 'firstHr',
                               'supersedes'])
        && d.timestamp is timestamp
        && d.timestamp <= request.time + duration.value(5, 'm')
        && d.timestamp >= request.time - duration.value(30, 'd')
        && d.recordedAt == request.time
        && d.entryMode == 'manual'
        && optInt(d, 'sbp', 60, 260) && optInt(d, 'dbp', 30, 160) && optInt(d, 'hr', 30, 220)
        && optInt(d, 'firstSbp', 60, 260) && optInt(d, 'firstDbp', 30, 160) && optInt(d, 'firstHr', 30, 220)
        && ((d.get('sbp', null) == null) == (d.get('dbp', null) == null))
        && (d.get('sbp', null) == null || d.sbp - d.dbp >= 10)
        && (d.get('glucose', null) == null || (d.glucose is number && d.glucose >= 1 && d.glucose <= 35))
        && (d.get('sbp', null) != null || d.get('glucose', null) != null)
        && d.readingCount in [1, 2]
        && d.context is string && d.notes is string && d.notes.size() <= 500
        && (d.get('supersedes', null) == null
            || (d.supersedes is string
                && exists(/databases/$(database)/documents/users/$(userId)/readings/$(d.supersedes))));
    }

    function eventKeys() {
      return ['patientId', 'clinicianId', 'tsTriggered', 'triggerSource', 'tier', 'score', 'readingId',
              'trigger', 'thresholdVersion', 'modelVersion', 'status'];
    }

    function isNewEvent(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(eventKeys())
        && d.patientId == userId
        && d.tsTriggered == request.time
        && d.status == 'open'
        && d.tier in ['yellow', 'red']
        && d.trigger is map
        && d.thresholdVersion is string;
    }

    // Escalation from the patient's own phone: rule or model trigger,
    // addressed to their assigned clinician (none yet: null).
    function isPatientEvent(userId) {
      return isSelf(userId)
        && isNewEvent(userId)
        && request.resource.data.triggerSource in ['rule', 'model']
        && request.resource.data.clinicianId == myProfile().get('assignedClinicianId', null);
    }

    // Non-transmission sweep from the assigned clinician's application.
    function isNonTransmissionEvent(userId) {
      return isAssignedClinicianOf(userId)
        && isNewEvent(userId)
        && request.resource.data.triggerSource == 'non_transmission'
        && request.resource.data.clinicianId == request.auth.uid;
    }

    // The clinician named as alternate by the queue-age sweep (worker) may
    // read and close an escalated event, not the rest of the record.
    function isEscalatedToMe() {
      return isClinician() && resource.data.get('escalatedTo', null) == request.auth.uid;
    }

    // A clinician names an alternate colleague (another clinician) for the
    // queue-age escalation, or removes them.
    function isValidAlternate() {
      let d = request.resource.data;
      return !d.diff(resource.data).affectedKeys().hasAny(['alternateClinicianId'])
        || d.get('alternateClinicianId', null) == null
        || (resource.data.role == 'clinician'
            && d.alternateClinicianId is string
            && d.alternateClinicianId != request.auth.uid
            && targetIsClinician(d.alternateClinicianId));
    }

    // The verdict closes an open event, once, and touches nothing else.
    function isVerdict(userId) {
      let d = request.resource.data;
      return (isAssignedClinicianOf(userId) || isEscalatedToMe())
        && resource.data.status == 'open'
        && d.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'tsReviewed', 'reviewedBy', 'verdict', 'action', 'comment'])
        && d.status == 'closed'
        && d.tsReviewed == request.time
        && d.reviewedBy == request.auth.uid
        && d.verdict in ['confirmed', 'not_significant', 'uncertain']
        && d.action in ['none', 'advice', 'treatment_change', 'consultation', 'referral']
        && d.comment is string && d.comment.size() <= 1000;
    }

    // A one-time claim of a clinician: the ONLY field changing is
    // assignedClinicianId, it was previously ABSENT, and the new value
    // points at a genuine clinician. Because the rule requires absence,
    // a patient cannot switch clinicians or detach once linked.
    function isFirstClinicianLink() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['assignedClinicianId'])
          && !resource.data.keys().hasAny(['assignedClinicianId'])
          && request.resource.data.assignedClinicianId is string
          && targetIsClinician(request.resource.data.assignedClinicianId);
    }

    // ---------------------------------------------------------------
    // Clinician enrolment codes
    // ---------------------------------------------------------------
    match /clinician_codes/{code} {
      // `get` — resolving ONE code you already know. Must be open to
      // unauthenticated callers, because a patient signing up has no
      // account yet at the moment they type the code.
      //
      // Safe because: the document holds only a clinician id and display
      // name; you must already know the exact code to read it; and
      // `list` below still blocks enumeration of the collection.
      allow get: if true;

      // `list` — querying the collection. Clinicians only, so nobody can
      // discover codes they were not given.
      allow list: if isClinician();

      allow write: if false;
    }

    // ---------------------------------------------------------------
    // User profiles
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSelf(userId)
                  || isMyPatientDoc()
                  || isMyClinicianDoc(userId);

      // Self-registration. assignedClinicianId is now OPTIONAL, but when
      // present it must point at a genuine clinician.
      allow create: if isSelf(userId)
                    && request.resource.data.role == 'patient'
                    && request.resource.data.email == request.auth.token.email
                    && (
                         !request.resource.data.keys().hasAny(['assignedClinicianId'])
                         || targetIsClinician(request.resource.data.assignedClinicianId)
                       );

      // Either an ordinary profile edit that leaves the protected fields
      // untouched, or the one-time clinician link.
      allow update: if (isSelf(userId)
                        && ( !touchesProtected() || isFirstClinicianLink() )
                        && isValidAlternate())
                    || isCheckupPeriodUpdate();

      allow delete: if false;

      match /readings/{readingId} {
        allow read: if isSelf(userId) || isAssignedClinicianOf(userId);
        allow create: if isSelf(userId) && isValidReading(userId);
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if isSelf(userId) || isAssignedClinicianOf(userId) || isEscalatedToMe();
        allow create: if isPatientEvent(userId) || isNonTransmissionEvent(userId);
        allow update: if isVerdict(userId);
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isSelf(userId) || isAssignedClinicianOf(userId);
        allow create: if (isSelf(userId) || isAssignedClinicianOf(userId))
                      && request.resource.data.senderId == request.auth.uid;
        // read receipt: the recipient sets readAt, nothing else
        allow update: if (isSelf(userId) || isAssignedClinicianOf(userId))
                      && resource.data.senderId != request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
                      && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    // Escalated events across patients, for the alternate's queue
    // (collection-group query on escalatedTo; index in firestore.indexes.json).
    match /{path=**}/events/{eventId} {
      allow read: if isEscalatedToMe();
    }
  }
}
